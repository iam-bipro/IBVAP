# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Web (Next.js) ─────────────────────────────────────────────────────────────
apps/web/node_modules/
apps/web/.pnp
apps/web/.pnp.*
apps/web/.yarn/*
!apps/web/.yarn/patches
!apps/web/.yarn/plugins
!apps/web/.yarn/releases
!apps/web/.yarn/versions
apps/web/coverage/
apps/web/.next/
apps/web/out/
apps/web/build/
apps/web/next-env.d.ts
apps/web/*.tsbuildinfo

# ── API (FastAPI / Python) ────────────────────────────────────────────────────
apps/api/venv/
apps/api/__pycache__/
apps/api/**/__pycache__/
apps/api/*.pyc
apps/api/uploads/

# ── Misc ──────────────────────────────────────────────────────────────────────
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel

# env files (opt-in to commit specific ones if needed)
.env*

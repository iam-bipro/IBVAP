{
  "name": "sentinelx",
  "version": "1.0.0",
  "private": true,
  "description": "SentinelX — Intelligent Behaviour & Vehicle Analysis Platform (IBVAP). Next.js frontend + FastAPI backend monorepo.",
  "scripts": {
    "dev":       "npm run dev   --prefix apps/web",
    "build":     "npm run build --prefix apps/web",
    "start":     "npm run start --prefix apps/web",
    "lint":      "npm run lint  --prefix apps/web",
    "dev:api":   "cd apps/api && uvicorn app.main:app --reload --port 8000",
    "install:web": "npm install --prefix apps/web",
    "install:api": "cd apps/api && pip install -r requirements.txt"
  }
}
